# Copy this file to .env and fill in real values. Never commit .env.
# NVIDIA API key for the answer model (https://build.nvidia.com)
NVIDIA_API_KEY=

# Qdrant vector database server (docker compose up -d qdrant).
# Leave empty to use the embedded database in storage/index/qdrant/ instead.
QDRANT_URL=http://localhost:6333
